{
  "version": 1,
  "cli": {
    "analytics": false
  },
  "projects": {
    "claims": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/styles.css"],
            "outputPath": "dist/claims"
          },
          "configurations": {
            "fixture": {
              "optimization": true,
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "600kB",
                  "maximumError": "800kB"
                }
              ]
            }
          },
          "defaultConfiguration": "fixture"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "fixture": {
              "buildTarget": "claims:build:fixture"
            }
          },
          "defaultConfiguration": "fixture"
        }
      }
    }
  }
}
