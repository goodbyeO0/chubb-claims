{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "claims.exposure.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "claimId", "claimRef", "claimVersion", "currency", "isOpen", "reserve"],
  "properties": {
    "eventId": {"type": "string", "format": "uuid"},
    "claimId": {"type": "string", "format": "uuid"},
    "claimRef": {"type": "string", "minLength": 1},
    "claimVersion": {"type": "integer", "minimum": 1},
    "currency": {"enum": ["MYR", "SGD", "THB", "IDR", "PHP", "HKD"]},
    "isOpen": {"type": "boolean"},
    "reserve": {"type": ["string", "null"], "pattern": "^(0|[1-9][0-9]{0,15})\\.[0-9]{2}$"}
  },
  "examples": [
    {"eventId":"00000000-0000-4000-8000-000000000305","claimId":"00000000-0000-4000-8000-000000000101","claimRef":"CL-101","claimVersion":5,"currency":"MYR","isOpen":true,"reserve":"5000.00"}
  ]
}
